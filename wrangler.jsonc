{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "whispers",
	"account_id": "ca884e724f7dd12fcc27bc13275af212", // the lab account (Eshin's), which holds the sciminds domains
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	// SvelteKit's adapter writes the server here; static files are served as assets
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
	// Cloudflare creates the DNS record and certificate for this on deploy
	"routes": [{ "pattern": "whispers.sciminds.app", "custom_domain": true }],
	// not secret, so they live here. The password and the study key are secrets (npx wrangler secret put)
	"vars": {
		"PB_URL": "https://sciminds.cloud",
		"PB_APP_EMAIL": "whispers-app@sciminds.cloud"
	}
}
