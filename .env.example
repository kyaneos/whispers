# Copy to .env. The dev server and the pocketbase/ scripts read it. .env is gitignored.
# In production, PB_URL and PB_APP_EMAIL live in wrangler.jsonc, and the password
# and the study key are Cloudflare secrets (npx wrangler secret put)

# The PocketBase instance (https://sciminds.cloud)
PB_URL=
# The one account in the whispers_app collection. It can reach only the whispers_
# collections. The server routes use it; participants never see it
PB_APP_EMAIL=
PB_APP_PASSWORD=

# The study key, the ?k= part of the link. Make one with: openssl rand -hex 16
# Give it to Cloudflare with: npx wrangler secret put STUDY_KEY
STUDY_KEY=
