# Copy to .env for local dev (npm run dev). .env is gitignored.
# In production, PB_URL and PB_APP_EMAIL live in wrangler.jsonc and the password
# is a Cloudflare secret: npx wrangler secret put PB_APP_PASSWORD

# The PocketBase instance (https://sciminds.cloud)
PB_URL=
# The one account in the whispers_app collection. It can reach only the whispers_
# collections. The server routes use it; participants never see it
PB_APP_EMAIL=
PB_APP_PASSWORD=
